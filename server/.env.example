# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/prernanode

# JWT
JWT_ACCESS_SECRET=change_this_to_a_long_random_string
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Email (Nodemailer - SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="PRERNA <your_email@gmail.com>"

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# AI Assistant (Part 4, multi-provider since Part 6) — required for /api/ai/career/*
# and /api/ai/story/* to work. Mentor-match and business-recommendations don't need
# this since they're real algorithmic/aggregation features, not LLM calls.
#
# Pick a provider and set ONLY its key/model — switching providers is a config change,
# never a code change:
AI_PROVIDER=anthropic
# AI_PROVIDER=gemini
# AI_PROVIDER=openai

# Generic key/model — works for whichever AI_PROVIDER is selected above.
AI_API_KEY=
AI_MODEL=

# Legacy per-provider vars (from before multi-provider support) still work if you
# already had ANTHROPIC_API_KEY set — leave AI_API_KEY blank and this is used instead.
# Get an Anthropic key at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1
